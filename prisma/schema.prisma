// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Singleton-per-key store so the cron dispatcher can tell it already ran
// today's daily-briefing / evening-reminder — the time-window check alone
// would otherwise re-fire on every invocation inside that window.
model CronState {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  key         String @unique
  lastRunDate String // "YYYY-MM-DD" in Europe/Chisinau
}

// Tracks the Telegram messages currently posted to the "Azi"/"Mâine" forum
// topics, so a refresh can delete the old set before posting the new one
// instead of the topic accumulating a duplicate list on every change.
model TopicDigest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique // "azi" | "maine"
  dateStr    String   // "YYYY-MM-DD" Moldova date this digest represents
  messageIds Int[]
  updatedAt  DateTime @updatedAt
}

// One active multi-step conversation per Telegram chat (creating a patient
// or an appointment via guided prompts instead of typing a slash command).
model TelegramSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId    String   @unique
  flow      String   // "pacient_nou" | "programare_noua"
  step      String   // current step name within the flow
  data      Json     // partial answers collected so far
  updatedAt DateTime @updatedAt
}

// Staff accounts for the admin panel. The ADMIN_EMAIL/ADMIN_PASSWORD env
// pair still works as a permanent owner login, so a broken/empty table can
// never lock everyone out.
model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String // scrypt: "salt:derivedKey", both hex
  permissions  String[] // page keys from lib/permissions.ts; empty = no access
  isActive     Boolean  @default(true)
  teamMemberId String?  @db.ObjectId // set when this account is a doctor
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
}

// Short-lived codes emailed for "forgot password". The code itself is only
// ever stored hashed, so a leaked database row can't be used to take over an
// account.
model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  codeHash  String // scrypt, same format as AdminUser.passwordHash
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// One row per doctor per calendar day, holding the hours that doctor is
// available. Absent row = not working that day.
model DoctorAvailability {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  teamMemberId String   @db.ObjectId
  date         String // "YYYY-MM-DD" in Europe/Chisinau
  hours        Int[] // 8..23
  updatedAt    DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@index([date])
}

// Booking lock. slotKey is unique and always written, so two people booking
// the same doctor-hour race on an index violation rather than silently
// overwriting each other. Deleted when the appointment is cancelled, which
// releases the slot.
model AppointmentSlot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slotKey       String   @unique // "{teamMemberId}|{YYYY-MM-DDTHH:mm}"
  appointmentId String   @unique @db.ObjectId
  createdAt     DateTime @default(now())
}

model Service {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  shortDesc    String
  description  String
  overview     String
  process      String
  recovery     String
  benefits     String[]
  images       String[]
  category     String
  price        Float?
  discountPrice Float?
  duration     Int      @default(30) // minutes — used for booking module
  bookable     Boolean  @default(true) // whether this service can be selected for appointments
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

model TeamMember {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         String
  description  String
  image        String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminUsers   AdminUser[]
  availability DoctorAvailability[]
  appointments Appointment[]
}

model Testimonial {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  content      String
  image        String?
  service      String?
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  url          String
  alt          String
  category     String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  key          String @unique
  value        String
  description  String?
}

model BlogPost {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  excerpt      String
  content      String
  sections     Json?
  coverImage   String
  category     String
  tags         String[]
  author       String   @default("TehnicalDent")
  isPublished  Boolean  @default(false)
  translations Json?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auto-sharing to the clinic's own Facebook Page and Instagram account.
  // The two ids double as "already posted" markers, so re-saving a published
  // article never posts it twice; socialError carries the last failure so the
  // admin can see why a share did not go out.
  shareToSocial   Boolean @default(false)
  facebookPostId  String?
  instagramPostId String?
  socialError     String?
}

// =============================================
// Booking module: Patients, Appointments, Notifications
// =============================================

model Patient {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  notes     String?  // medical notes / observations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments      Appointment[]
  whatsappMessages  WhatsAppMessage[]

  @@index([phone])
  @@index([name])
}

enum WhatsAppDirection {
  in
  out
}

// Incoming/outgoing WhatsApp chat messages (separate from the appointment
// Notification log) — powers the admin WhatsApp inbox.
model WhatsAppMessage {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  phone       String            // E.164, e.g. +37360123456
  direction   WhatsAppDirection
  body        String
  waMessageId String?           // Meta's message id, for dedup
  patientId   String?           @db.ObjectId
  createdAt   DateTime          @default(now())

  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([createdAt])
}

enum SocialChannel {
  messenger
  instagram
}

// Messenger / Instagram DM history. Kept separate from WhatsAppMessage
// because the identity is a Meta-scoped user id (PSID/IGSID) rather than a
// phone number, and the two channels have their own inbox pages.
model SocialMessage {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  channel       SocialChannel
  senderId      String            // PSID (Messenger) or IGSID (Instagram)
  senderName    String?           // profile name, when the API exposes it
  direction     WhatsAppDirection // same in/out meaning
  body          String
  metaMessageId String?           // for dedup across webhook retries
  createdAt     DateTime          @default(now())

  @@index([channel, senderId])
  @@index([createdAt])
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  noshow
  test // marks throwaway/test appointments — excluded from reminders, recall, Azi/Mâine digests
}

model Appointment {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String            @db.ObjectId
  serviceId   String            @db.ObjectId
  dateTime    DateTime
  duration    Int               // minutes — snapshot of service duration at booking time
  status      AppointmentStatus @default(pending)
  notes       String?
  // Public confirm/cancel link token (signed) — stored hash for security
  confirmToken String?
  remindedAt   DateTime?         // last reminder timestamp (debounce)
  recallSent   Boolean           @default(false) // 6-month recall sent?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teamMemberId String? @db.ObjectId // assigned doctor

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id])
  teamMember    TeamMember?    @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([dateTime])
  @@index([status])
  @@index([patientId])
  @@index([serviceId])
  @@index([teamMemberId])
}

enum NotificationType {
  created            // sent on creation (admin + client)
  reminder_24h
  reminder_2h
  recall_6m
  cancelled
  confirmed
  completed
  campaign // manual admin broadcast (offer / reminder) to one or more patients
  error
}

enum NotificationChannel {
  telegram
  whatsapp
  email
  sms
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Notification {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String?             @db.ObjectId
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus  @default(queued)
  recipient     String              // phone, chat id or email
  payload       String              // message body (for log/debug)
  attempts      Int                 @default(0)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
  @@index([type])
}
