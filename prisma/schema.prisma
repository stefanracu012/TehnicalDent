// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Singleton-per-key store so the cron dispatcher can tell it already ran
// today's daily-briefing / evening-reminder — the time-window check alone
// would otherwise re-fire on every invocation inside that window.
model CronState {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  key         String @unique
  lastRunDate String // "YYYY-MM-DD" in Europe/Chisinau
}

// Tracks the Telegram messages currently posted to the "Azi"/"Mâine" forum
// topics, so a refresh can delete the old set before posting the new one
// instead of the topic accumulating a duplicate list on every change.
model TopicDigest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique // "azi" | "maine"
  dateStr    String   // "YYYY-MM-DD" Moldova date this digest represents
  messageIds Int[]
  updatedAt  DateTime @updatedAt
}

// One active multi-step conversation per Telegram chat (creating a patient
// or an appointment via guided prompts instead of typing a slash command).
model TelegramSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId    String   @unique
  flow      String   // "pacient_nou" | "programare_noua"
  step      String   // current step name within the flow
  data      Json     // partial answers collected so far
  updatedAt DateTime @updatedAt
}

// Staff accounts for the admin panel. The ADMIN_EMAIL/ADMIN_PASSWORD env
// pair still works as a permanent owner login, so a broken/empty table can
// never lock everyone out.
model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String // scrypt: "salt:derivedKey", both hex
  permissions  String[] // page keys from lib/permissions.ts; empty = no access
  isActive     Boolean  @default(true)
  teamMemberId String?  @db.ObjectId // set when this account is a doctor
  telegramId   String? // personal Telegram chat id, for notifications meant only for them
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
}

// Short-lived codes emailed for "forgot password". The code itself is only
// ever stored hashed, so a leaked database row can't be used to take over an
// account.
model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  codeHash  String // scrypt, same format as AdminUser.passwordHash
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// One row per doctor per calendar day, holding the hours that doctor is
// available. Absent row = not working that day.
model DoctorAvailability {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  teamMemberId String   @db.ObjectId
  date         String // "YYYY-MM-DD" in Europe/Chisinau
  hours        Int[] // 8..23
  updatedAt    DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@index([date])
}

// Booking lock. slotKey is unique and always written, so two people booking
// the same doctor-hour race on an index violation rather than silently
// overwriting each other. Deleted when the appointment is cancelled, which
// releases the slot.
model AppointmentSlot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slotKey       String   @unique // "{teamMemberId}|{YYYY-MM-DDTHH:mm}"
  appointmentId String   @unique @db.ObjectId
  createdAt     DateTime @default(now())
}

model Service {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  shortDesc    String
  description  String
  overview     String
  process      String
  recovery     String
  benefits     String[]
  images       String[]
  category     String
  price        Float?
  discountPrice Float?
  duration     Int      @default(30) // minutes — used for booking module
  bookable     Boolean  @default(true) // whether this service can be selected for appointments
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

model TeamMember {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         String
  description  String
  image        String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminUsers   AdminUser[]
  availability DoctorAvailability[]
  appointments Appointment[]
}

model Testimonial {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  content      String
  image        String?
  service      String?
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  url          String
  alt          String
  category     String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  key          String @unique
  value        String
  description  String?
}

model BlogPost {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  excerpt      String
  content      String
  sections     Json?
  coverImage   String
  category     String
  tags         String[]
  author       String   @default("TehnicalDent")
  isPublished  Boolean  @default(false)
  translations Json?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Search snippet, kept apart from title/excerpt: a good H1 reads differently
  // from a good <title>, and the card preview differs from a meta description.
  // Both fall back to title/excerpt when empty.
  metaTitle       String?
  metaDescription String?

  // Platform-specific captions. Facebook renders links, Instagram does not, so
  // one caption cannot serve both well.
  facebookCaption  String?
  instagramCaption String?

  // 1200x630 rendering of coverImage for link previews, which crop to 1.91:1
  // and would otherwise cut the top and bottom off a square cover. Regenerated
  // whenever coverImage changes; ogImageFor records what it was built from.
  ogImage    String?
  ogImageFor String?

  // Auto-sharing to the clinic's own Facebook Page and Instagram account.
  // The two ids double as "already posted" markers, so re-saving a published
  // article never posts it twice; socialError carries the last failure so the
  // admin can see why a share did not go out.
  shareToSocial   Boolean @default(false)
  // Whether the post invites people to read the article — decided per network,
  // because the two behave differently. Facebook makes the URL tappable, so a
  // link there costs nothing; Instagram shows it as plain text, which is worth
  // it for a piece someone would go and type, and clutter for one they would not.
  linkOnFacebook  Boolean @default(true)
  linkOnInstagram Boolean @default(true)
  facebookPostId  String?
  instagramPostId String?
  socialError     String?
}

// =============================================
// Booking module: Patients, Appointments, Notifications
// =============================================

/**
 * A post that lives only on Facebook and Instagram — no page on the site.
 *
 * Kept apart from BlogPost rather than flagged inside it: a social post has no
 * slug, no sections and no search snippet, and forcing those to be optional
 * would weaken the article model for every real article.
 */
model SocialPost {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  // Internal label for the admin list; never published anywhere.
  title String
  // 1-10 images. The first is the one Facebook and Instagram show first, and
  // the only one used when there is no carousel.
  images String[]

  facebookCaption  String
  instagramCaption String
  tags             String[]
  // Slug of a related article, when the post is meant to drive traffic to one.
  articleSlug String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  facebookPostId  String?
  instagramPostId String?
  socialError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One pull of the Meta ads report, kept rather than fetched per page view.
 *
 * The page reads the newest row, so opening it costs nothing and never waits on
 * Meta. Rows also serve as the refresh log: the rate limit counts how many were
 * written in the last hour, which survives restarts in a way an in-memory
 * counter would not.
 */
model AdsSnapshot {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  // The computed report: totals, funnel, per-ad and per-campaign rows.
  data Json
  // What the assistant made of it. Null when the analysis failed but the
  // numbers came through — the report is still worth showing.
  analysis    String?
  fetchedAt   DateTime @default(now())
  fetchedBy   String?
  @@index([fetchedAt])
}

/**
 * One question and its answer, kept so the thread survives a page reload.
 *
 * Stored as pairs rather than a message stream: an answer without its question
 * is noise, and deleting one should never leave the other stranded.
 */
model AdsChatEntry {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String
  // Which pull the answer was grounded in, so an old answer can be told apart
  // from one about the current numbers.
  basedOn   DateTime?
  askedBy   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AssistantMode {
  /** Never replies. The state every channel starts in. */
  oprit
  /** Replies only in conversations somebody added by hand. */
  selectat
  /** Replies to everyone on that channel. */
  toti
}

/**
 * Whether the assistant may answer on a channel, one row per channel.
 *
 * A missing row reads as "oprit": a channel that has never been configured must
 * not start talking to patients because a deploy added the feature.
 */
model AssistantChannel {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  channel   String        @unique // "whatsapp" | "messenger" | "instagram"
  mode      AssistantMode @default(oprit)
  updatedAt DateTime      @updatedAt
}

/** One conversation the assistant is allowed into while the channel is on "selectat". */
model AssistantAllowed {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  channel String
  /** Phone in E.164 for WhatsApp, PSID or IGSID for the Meta channels. */
  handle  String
  label   String? // name, so the admin list is readable
  createdAt DateTime @default(now())

  @@unique([channel, handle])
}

enum LeadSource {
  messenger
  instagram
  whatsapp
  formular
  manual
}

enum LeadStatus {
  nou
  contactat
  programat
  convertit
  pierdut
}

/**
 * Someone who reached out and is not a patient yet.
 *
 * Kept as its own record rather than derived from the message tables: a lead
 * carries state those tables have no room for — who is chasing it, when to
 * chase again, why it was lost. Deriving it would recompute that from nothing
 * every time.
 */
model Lead {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  name  String?
  phone String? // E.164 when we could parse one
  email String?

  source LeadSource
  /**
   * "<source>:<conversation or submission id>". Unique and always written, so a
   * second message from the same person updates the lead instead of opening a
   * duplicate beside it.
   */
  sourceKey    String  @unique
  firstMessage String?

  status LeadStatus @default(nou)
  note   String?
  /** When to chase. The list shows overdue ones first. */
  followUpAt DateTime?

  patientId String? @db.ObjectId
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([followUpAt])
  @@index([phone])
}

model Patient {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  notes     String?  // medical notes / observations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments      Appointment[]
  whatsappMessages  WhatsAppMessage[]
  leads             Lead[]

  @@index([phone])
  @@index([name])
}

enum WhatsAppDirection {
  in
  out
}

// Incoming/outgoing WhatsApp chat messages (separate from the appointment
// Notification log) — powers the admin WhatsApp inbox.
model WhatsAppMessage {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  phone       String            // E.164, e.g. +37360123456
  direction   WhatsAppDirection
  body        String
  waMessageId String?           // Meta's message id, for dedup
  patientId   String?           @db.ObjectId
  createdAt   DateTime          @default(now())

  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([createdAt])
}

enum SocialChannel {
  messenger
  instagram
}

// Messenger / Instagram DM history. Kept separate from WhatsAppMessage
// because the identity is a Meta-scoped user id (PSID/IGSID) rather than a
// phone number, and the two channels have their own inbox pages.
model SocialMessage {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  channel       SocialChannel
  senderId      String            // PSID (Messenger) or IGSID (Instagram)
  senderName    String?           // profile name, when the API exposes it
  direction     WhatsAppDirection // same in/out meaning
  body          String
  metaMessageId String?           // for dedup across webhook retries
  // Which Page or Instagram account received it. Older rows predate this and
  // are null, which is why they cannot be sorted by origin after the fact.
  pageId        String?
  createdAt     DateTime          @default(now())

  @@index([channel, senderId])
  @@index([createdAt])
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  noshow
  test // marks throwaway/test appointments — excluded from reminders, recall, Azi/Mâine digests
}

model Appointment {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String            @db.ObjectId
  serviceId   String            @db.ObjectId
  dateTime    DateTime
  duration    Int               // minutes — snapshot of service duration at booking time
  status      AppointmentStatus @default(pending)
  notes       String?
  // Public confirm/cancel link token (signed) — stored hash for security
  confirmToken String?
  remindedAt   DateTime?         // last reminder timestamp (debounce)
  recallSent   Boolean           @default(false) // 6-month recall sent?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teamMemberId String? @db.ObjectId // assigned doctor

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id])
  teamMember    TeamMember?    @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([dateTime])
  @@index([status])
  @@index([patientId])
  @@index([serviceId])
  @@index([teamMemberId])
}

enum NotificationType {
  created            // sent on creation (admin + client)
  reminder_24h
  reminder_2h
  recall_6m
  cancelled
  confirmed
  completed
  campaign // manual admin broadcast (offer / reminder) to one or more patients
  error
}

enum NotificationChannel {
  telegram
  whatsapp
  email
  sms
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Notification {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String?             @db.ObjectId
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus  @default(queued)
  recipient     String              // phone, chat id or email
  payload       String              // message body (for log/debug)
  attempts      Int                 @default(0)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
  @@index([type])
}

// One-time codes for linking a Telegram chat to an admin account.
//
// The account asks for a code, the person opens the bot with it in the deep
// link, and the bot writes their chat id back to the account. That way nobody
// has to read an id off a screen and retype it, and a code that leaks is
// useless within a quarter of an hour.
model TelegramLink {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique
  adminUserId String    @db.ObjectId
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}
